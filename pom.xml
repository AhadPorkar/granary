<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.granary</groupId>
  <artifactId>granary-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>Granary</name>
  <description>Universal, offline-first artifact repository manager (Maven, npm, NuGet, …)</description>
  <url>https://github.com/AhadPorkar/granary</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Business Source License 1.1</name>
      <url>https://github.com/AhadPorkar/granary/blob/main/LICENSE</url>
    </license>
  </licenses>

  <modules>
    <module>granary-core</module>
    <module>granary-format-maven</module>
    <module>granary-format-npm</module>
    <module>granary-format-nuget</module>
    <module>granary-ui</module>
    <module>granary-server</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <skipTests>false</skipTests>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <wiremock.version>3.13.2</wiremock.version>
    <jjwt.version>0.13.0</jjwt.version>
    <jacoco.version>0.8.15</jacoco.version>
    <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    <node.version>v22.22.0</node.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.granary</groupId>
        <artifactId>granary-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.granary</groupId>
        <artifactId>granary-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>dev.granary</groupId>
        <artifactId>granary-format-maven</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.granary</groupId>
        <artifactId>granary-format-npm</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.granary</groupId>
        <artifactId>granary-format-nuget</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.granary</groupId>
        <artifactId>granary-ui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>${frontend-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Mockito's inline mock maker needs to be attached as an agent on modern JDKs. -->
          <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
